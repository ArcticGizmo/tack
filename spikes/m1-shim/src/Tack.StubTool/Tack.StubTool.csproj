<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A stand-in "real tool" for the M1 spike. It prints its own identity + cwd + forwarded args and exits
    with a chosen code, so the tests can assert the shim dispatched to the RIGHT binary, forwarded args,
    ran in the caller's cwd, and propagated the exit code. (Perch proved its installer against a real
    loopback HttpListener rather than a mock; same spirit - exercise the real exec mechanism.)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>tack-stub</AssemblyName>
    <RootNamespace>Tack.StubTool</RootNamespace>
  </PropertyGroup>
</Project>

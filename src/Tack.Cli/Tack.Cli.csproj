<Project Sdk="Microsoft.NET.Sdk">
  <!-- The `tack` command (assembly/exe name `tack`). Console app, and tack's only front-end: a rich
       Spectre.Console CLI over Tack.Core. It is also the Velopack mainExe, so it hosts the install lifecycle
       callbacks that wire tack onto the user PATH. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tack.Cli</RootNamespace>
    <AssemblyName>tack</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Trim the self-contained publish (no effect on build/run/test). Partial, not full: only assemblies that
         declare themselves trim-safe (the runtime's own) are trimmed, while tack, Spectre.Console.Cli (which
         discovers commands and settings by reflection), YamlDotNet and Velopack are kept whole. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.49.1" />
    <!-- Full YAML parser for authoring/validating tack.yml. Deliberately lives here, NOT in Tack.Core:
         YamlDotNet is reflection-based (AOT-hostile), and the shim must never pull it in. A cross-check
         test asserts this parser and Core's mini-parser agree on the tack.yml subset. -->
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tack.Core\Tack.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- `tack update` reads the feed URL from this, keeping Directory.Build.props the single source of truth. -->
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The changelog is embedded so `tack changelog` can render it with no file dependency at runtime
         (read via the assembly manifest under the logical name "Tack.CHANGELOG.md"). -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Tack.CHANGELOG.md" />
  </ItemGroup>

  <Import Project="..\DevShim.targets" />
</Project>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Tack.App.MainWindow"
        Width="640" Height="420" Title="tack"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="28" Spacing="14" VerticalAlignment="Center">
    <TextBlock Text="tack" FontSize="40" FontWeight="Bold" />
    <TextBlock Text="Per-directory tool-version dispatcher for Windows." FontSize="16" Opacity="0.85" />
    <TextBlock TextWrapping="Wrap" Opacity="0.6"
               Text="M0 skeleton. The real UI - dashboard, directory inspector, registry and bindings editors, and the PATH doctor - arrives in M4." />
  </StackPanel>
</Window>

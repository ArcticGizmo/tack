<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tack.App.ViewModels"
        xmlns:views="using:Tack.App.Views"
        x:Class="Tack.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1040" Height="700" MinWidth="820" MinHeight="520"
        Title="tack" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource FormBgBrush}">

  <Window.Resources>
    <vm:IntEqualsConverter x:Key="IntEq" />
  </Window.Resources>

  <Grid ColumnDefinitions="210,*">

    <!-- Left nav rail: the lighter panel surface, with a divider against the darker content page. -->
    <Border Grid.Column="0" Background="{DynamicResource PanelBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,20,18,16" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="tack" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center" />
            <TextBlock Text="(Dev)" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{DynamicResource WarnBrush}" IsVisible="{Binding IsDev}" />
          </StackPanel>
          <TextBlock Text="per-directory tool dispatch" Classes="help" FontSize="11" />
        </StackPanel>

        <StackPanel Margin="8,6" Spacing="1">
          <Button Classes="nav" Command="{Binding SelectCommand}" CommandParameter="0">
            <Border Classes="navitem" Classes.active="{Binding SelectedTabIndex, Converter={StaticResource IntEq}, ConverterParameter=0}">
              <TextBlock Text="Dashboard" FontSize="14" Foreground="{DynamicResource FgBrush}" />
            </Border>
          </Button>
          <Button Classes="nav" Command="{Binding SelectCommand}" CommandParameter="1">
            <Border Classes="navitem" Classes.active="{Binding SelectedTabIndex, Converter={StaticResource IntEq}, ConverterParameter=1}">
              <TextBlock Text="Inspector" FontSize="14" Foreground="{DynamicResource FgBrush}" />
            </Border>
          </Button>
          <Button Classes="nav" Command="{Binding SelectCommand}" CommandParameter="2">
            <Border Classes="navitem" Classes.active="{Binding SelectedTabIndex, Converter={StaticResource IntEq}, ConverterParameter=2}">
              <TextBlock Text="Registry" FontSize="14" Foreground="{DynamicResource FgBrush}" />
            </Border>
          </Button>
          <Button Classes="nav" Command="{Binding SelectCommand}" CommandParameter="3">
            <Border Classes="navitem" Classes.active="{Binding SelectedTabIndex, Converter={StaticResource IntEq}, ConverterParameter=3}">
              <TextBlock Text="Zones" FontSize="14" Foreground="{DynamicResource FgBrush}" />
            </Border>
          </Button>
          <Button Classes="nav" Command="{Binding SelectCommand}" CommandParameter="4">
            <Border Classes="navitem" Classes.active="{Binding SelectedTabIndex, Converter={StaticResource IntEq}, ConverterParameter=4}">
              <TextBlock Text="PATH" FontSize="14" Foreground="{DynamicResource FgBrush}" />
            </Border>
          </Button>
          <Button Classes="nav" Command="{Binding SelectCommand}" CommandParameter="5">
            <Border Classes="navitem" Classes.active="{Binding SelectedTabIndex, Converter={StaticResource IntEq}, ConverterParameter=5}">
              <TextBlock Text="What's New" FontSize="14" Foreground="{DynamicResource FgBrush}" />
            </Border>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content: one page at a time, switched by the rail. No page transition (snappier). -->
    <Carousel Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}">
      <Carousel.PageTransition>
        <CrossFade Duration="0:0:0.12" />
      </Carousel.PageTransition>
      <views:DashboardView DataContext="{Binding Dashboard}" />
      <views:InspectorView DataContext="{Binding Inspector}" />
      <views:RegistryView DataContext="{Binding Registry}" />
      <views:ZonesView DataContext="{Binding Zones}" />
      <views:PathView DataContext="{Binding Path}" />
      <views:ChangelogView DataContext="{Binding Changelog}" />
    </Carousel>
  </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tack.App.ViewModels"
        xmlns:views="using:Tack.App.Views"
        x:Class="Tack.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1000" Height="680" MinWidth="760" MinHeight="480"
        Title="tack" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PanelBgBrush}">

  <TabControl TabStripPlacement="Left" SelectedIndex="{Binding SelectedTabIndex}" Padding="0">
    <TabItem Header="Dashboard">
      <views:DashboardView DataContext="{Binding Dashboard}" />
    </TabItem>
    <TabItem Header="Inspector">
      <views:InspectorView DataContext="{Binding Inspector}" />
    </TabItem>
    <TabItem Header="Registry">
      <views:RegistryView DataContext="{Binding Registry}" />
    </TabItem>
    <TabItem Header="Bindings">
      <views:BindingsView DataContext="{Binding Bindings}" />
    </TabItem>
    <TabItem Header="PATH">
      <views:PathView DataContext="{Binding Path}" />
    </TabItem>
    <TabItem Header="Shims">
      <views:ShimsView DataContext="{Binding Shims}" />
    </TabItem>
  </TabControl>
</Window>

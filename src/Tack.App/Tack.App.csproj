<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Avalonia desktop head (exe name `tack-ui`, WinExe). Launched by `tack open`, and the Velopack
       Start-Menu shortcut target. M4 fills it in: a tabbed shell (dashboard, directory inspector,
       registry/bindings editors, PATH doctor), all MVVM over the same Tack.Core the CLI drives.
       This head also hosts the Velopack install lifecycle callbacks that wire tack onto the user PATH.
       Windows-only in v1. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Tack.App</RootNamespace>
    <AssemblyName>tack-ui</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <!-- The curated WCAG-AA palette package perch themes from (assembly/namespace Palette.Theming). We apply
         its built-in Nord (Dark) scheme: ThemeManager publishes ~70 semantic token brushes into
         Application.Resources, consumed as {DynamicResource PanelBgBrush} / FgBrush / AccentBrush / ... -->
    <PackageReference Include="ArcticGizmo.Avalonia.Palette" Version="0.2.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tack.Core\Tack.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The changelog is embedded so the What's New tab and the post-update popup can render it at runtime
         (read via the assembly manifest under the logical name "Tack.CHANGELOG.md"). -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Tack.CHANGELOG.md" />
  </ItemGroup>

  <Import Project="..\DevShim.targets" />
</Project>

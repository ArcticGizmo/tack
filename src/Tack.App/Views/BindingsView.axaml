<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tack.App.ViewModels"
             x:Class="Tack.App.Views.BindingsView"
             x:DataType="vm:BindingsViewModel">
  <DockPanel Margin="18">

    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <TextBlock Text="Bindings" FontSize="22" FontWeight="Bold" />
      <TextBlock Text="Central directory rules that pin a tool version without a repo tack.yml. Enforced rules beat a tack.yml (org enforcement)."
                 Opacity="0.7" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
        <Button Content="Remove" Command="{Binding RemoveCommand}" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
      </StackPanel>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
            Padding="14" Margin="0,12,0,0">
      <StackPanel Spacing="8">
        <TextBlock Text="Add a binding" FontWeight="Bold" Opacity="0.75" />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Text="Glob" VerticalAlignment="Center" />
          <TextBox   Grid.Column="1" Text="{Binding NewGlob}" PlaceholderText="C:/work/employer/**" />
        </Grid>
        <Grid ColumnDefinitions="Auto,1.2*,Auto,1*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Text="Tool" VerticalAlignment="Center" />
          <TextBox   Grid.Column="1" Text="{Binding NewTool}" PlaceholderText="node" />
          <TextBlock Grid.Column="2" Text="Version" VerticalAlignment="Center" />
          <TextBox   Grid.Column="3" Text="{Binding NewVersion}" PlaceholderText="18.19.0" />
          <CheckBox  Grid.Column="4" Content="Enforce" IsChecked="{Binding NewEnforce}" VerticalAlignment="Center" />
          <Button    Grid.Column="5" Content="Add" Command="{Binding AddCommand}" Classes="accent" />
        </Grid>
        <TextBlock Text="{Binding Status}" Opacity="0.85" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <DockPanel>
      <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}" Padding="0,8,0,6" Margin="0,8,0,0">
        <Grid ColumnDefinitions="3*,1.2*,1*,1*">
          <TextBlock Grid.Column="0" Text="GLOB" FontWeight="Bold" FontSize="11" Opacity="0.6" />
          <TextBlock Grid.Column="1" Text="TOOL" FontWeight="Bold" FontSize="11" Opacity="0.6" />
          <TextBlock Grid.Column="2" Text="VERSION" FontWeight="Bold" FontSize="11" Opacity="0.6" />
          <TextBlock Grid.Column="3" Text="ENFORCE" FontWeight="Bold" FontSize="11" Opacity="0.6" />
        </Grid>
      </Border>
      <ListBox ItemsSource="{Binding Bindings}" SelectedItem="{Binding Selected}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:BindingRow">
            <Grid ColumnDefinitions="3*,1.2*,1*,1*">
              <TextBlock Grid.Column="0" Text="{Binding Glob}"
                         FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Grid.Column="1" Text="{Binding Tool}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="2" Text="{Binding Version}" />
              <TextBlock Grid.Column="3" Text="{Binding EnforceMark}" Foreground="{DynamicResource DangerBrush}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </DockPanel>
</UserControl>

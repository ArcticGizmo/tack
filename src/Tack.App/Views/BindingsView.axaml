<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tack.App.ViewModels"
             x:Class="Tack.App.Views.BindingsView"
             x:DataType="vm:BindingsViewModel">
  <Grid Margin="28,24" RowDefinitions="Auto,*,Auto" RowSpacing="16">

    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Classes="pagetitle" Text="Bindings" />
      <TextBlock Classes="help"
                 Text="Central directory rules that pin a tool version without a repo tack.yml. Enforced rules beat a tack.yml (org enforcement)." />
    </StackPanel>

    <Border Grid.Row="1" Classes="card" Padding="20,14">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,10">
          <TextBlock Grid.Column="0" Classes="phead" Text="BINDINGS" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="danger" Content="Remove" Padding="12,6" FontSize="12" Command="{Binding RemoveCommand}" />
          <Button Grid.Column="2" Classes="secondary" Content="Refresh" Padding="12,6" FontSize="12" Command="{Binding RefreshCommand}" />
        </Grid>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="3*,1.2*,1*,1*" Margin="10,0,10,6">
          <TextBlock Grid.Column="0" Classes="phead" Text="GLOB" />
          <TextBlock Grid.Column="1" Classes="phead" Text="TOOL" />
          <TextBlock Grid.Column="2" Classes="phead" Text="VERSION" />
          <TextBlock Grid.Column="3" Classes="phead" Text="ENFORCE" />
        </Grid>

        <ListBox Classes="rows" ItemsSource="{Binding Bindings}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BindingRow">
              <Grid ColumnDefinitions="3*,1.2*,1*,1*">
                <TextBlock Grid.Column="0" Text="{Binding Glob}" Classes="mono" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Text="{Binding Tool}" Classes="field" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="{Binding Version}" Classes="field" />
                <TextBlock Grid.Column="3" Text="{Binding EnforceMark}" Foreground="{DynamicResource DangerBrush}" FontSize="13" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Border Grid.Row="2" Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Classes="phead" Text="ADD A BINDING" />
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Classes="field" Text="Glob" VerticalAlignment="Center" />
          <TextBox   Grid.Column="1" Text="{Binding NewGlob}" PlaceholderText="C:/work/employer/**" />
        </Grid>
        <Grid ColumnDefinitions="Auto,1.2*,Auto,1*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Classes="field" Text="Tool" VerticalAlignment="Center" />
          <TextBox   Grid.Column="1" Text="{Binding NewTool}" PlaceholderText="node" />
          <TextBlock Grid.Column="2" Classes="field" Text="Version" VerticalAlignment="Center" />
          <TextBox   Grid.Column="3" Text="{Binding NewVersion}" PlaceholderText="18.19.0" />
          <CheckBox  Grid.Column="4" Content="Enforce" IsChecked="{Binding NewEnforce}" VerticalAlignment="Center" />
          <Button    Grid.Column="5" Classes="primary" Content="Add" Command="{Binding AddCommand}" />
        </Grid>
        <TextBlock Classes="status muted" FontSize="13" TextWrapping="Wrap" Text="{Binding Status}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

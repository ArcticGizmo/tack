<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tack.App.ViewModels"
             x:Class="Tack.App.Views.ChangelogView"
             x:DataType="vm:ChangelogViewModel">
  <Grid Margin="28,24" RowDefinitions="Auto,*" RowSpacing="16">

    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Classes="pagetitle" Text="What's New" />
      <TextBlock Classes="help"
                 Text="Everything that has changed in tack, newest first." />
    </StackPanel>

    <Border Grid.Row="1" Classes="card">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <!-- Populated in code-behind from the parsed changelog sections (markdown -> themed controls). -->
        <StackPanel x:Name="Entries" Spacing="2" />
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tack.App.ViewModels"
             x:Class="Tack.App.Views.InspectorView"
             x:DataType="vm:InspectorViewModel">
  <Grid Margin="28,24" RowDefinitions="Auto,Auto,*" RowSpacing="16">

    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Classes="pagetitle" Text="Directory inspector" />
      <TextBlock Classes="help"
                 Text="Pick any folder and see exactly what tack resolves there - the debugger for &quot;why is that IDE using the wrong version?&quot;" />
    </StackPanel>

    <Border Grid.Row="1" Classes="card">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Classes="field" Text="Directory" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Directory}" />
        <Button Grid.Column="2" Classes="secondary" Content="Browse..." Command="{Binding BrowseCommand}" />
        <Button Grid.Column="3" Classes="primary" Content="Inspect" Command="{Binding InspectCommand}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,1.1*" ColumnSpacing="16">
      <Border Grid.Column="0" Classes="card" Padding="14,12">
        <ListBox Classes="rows" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ResolutionRow">
              <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="{Binding Tool}" Classes="field" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Version}" Classes="field" />
                <TextBlock Grid.Column="2" Text="{Binding SourceLabel}" Foreground="{Binding SourceBrush}" FontSize="13" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="phead" Text="RESOLUTION" />
          <SelectableTextBlock Text="{Binding Detail}" Classes="mono" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>

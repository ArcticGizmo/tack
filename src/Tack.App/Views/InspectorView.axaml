<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tack.App.ViewModels"
             x:Class="Tack.App.Views.InspectorView"
             x:DataType="vm:InspectorViewModel">
  <DockPanel Margin="18">

    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <TextBlock Text="Directory inspector" FontSize="22" FontWeight="Bold" />
      <TextBlock Text="Pick any folder and see exactly what tack resolves there - the debugger for &quot;why is that IDE using the wrong version?&quot;"
                 Opacity="0.7" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Text="Directory" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Directory}" />
        <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseCommand}" />
        <Button Grid.Column="3" Content="Inspect" Command="{Binding InspectCommand}" />
      </Grid>
    </StackPanel>

    <Grid ColumnDefinitions="*,Auto,1.1*" Margin="0,14,0,0">
      <ListBox Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
               Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ResolutionRow">
            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="{Binding Tool}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding Version}" />
              <TextBlock Grid.Column="2" Text="{Binding SourceLabel}" Foreground="{Binding SourceBrush}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Column="1" Width="6" Background="Transparent" />

      <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="Resolution" FontWeight="Bold" Opacity="0.7" />
          <TextBlock Text="{Binding Detail}" FontFamily="Cascadia Code,Consolas,monospace" FontSize="13"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
